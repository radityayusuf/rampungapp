PORT=8000
DATABASE_URL="mysql://root:@127.0.0.1:3306/rampung"
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
FRONTEND_URL="http://localhost:3000"
AUTH_THROTTLE=200

# Wajib untuk login Google (Client ID OAuth Web dari Google Cloud Console)
GOOGLE_CLIENT_ID=

# Email superadmin awal (dipisah koma). Hanya berlaku jika email sudah terverifikasi lewat Google.
SUPERADMIN_EMAILS=

# Email (undangan & reset kata sandi). Kosongkan SMTP_HOST untuk mode pengembangan: tautan hanya dicetak di log server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rampung <no-reply@rampung.id>"

# Isi 1 jika backend di belakang nginx/Docker (agar batas percobaan memakai IP klien asli)
TRUST_PROXY=0

# ── Integrasi (semua opsional; tanpa kunci, fiturnya menjawab "belum dikonfigurasi", tidak pura-pura) ──
# Pembayaran paket tidak memakai penyedia luar: QRIS dan rekening diatur di Panel Superadmin → Pengaturan pembayaran.
# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Asisten AI (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
