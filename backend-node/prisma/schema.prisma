generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model api_tokens {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt    @db.UnsignedBigInt
  token_hash   String    @unique(map: "api_tokens_token_hash_unique") @db.VarChar(64)
  last_used_at DateTime? @db.Timestamp(0)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  name         String?   @db.VarChar(60)

  @@index([user_id], map: "api_tokens_user_id_index")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration BigInt

  @@index([expiration], map: "cache_expiration_index")
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration BigInt

  @@index([expiration], map: "cache_locks_expiration_index")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.VarChar(255)
  queue      String   @db.VarChar(255)
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)

  @@index([connection, queue, failed_at], map: "failed_jobs_connection_queue_failed_at_index")
}

model invites {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id BigInt    @db.UnsignedBigInt
  email        String    @db.VarChar(190)
  role         String    @default("member") @db.VarChar(16)
  token        String    @unique(map: "invites_token_unique") @db.VarChar(40)
  invited_by   BigInt?   @db.UnsignedBigInt
  accepted_at  DateTime? @db.Timestamp(0)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)

  @@index([workspace_id], map: "invites_workspace_id_index")
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.MediumText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedSmallInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model records {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id BigInt    @db.UnsignedBigInt
  collection   String    @db.VarChar(32)
  rid          String    @db.VarChar(100)
  data         String    @db.LongText
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)

  @@unique([workspace_id, collection, rid], map: "records_workspace_id_collection_rid_unique")
  @@index([workspace_id], map: "records_workspace_id_index")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model users {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id      BigInt?   @db.UnsignedBigInt
  role              String    @default("member") @db.VarChar(16)
  name              String    @db.VarChar(255)
  email             String    @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at DateTime? @db.Timestamp(0)
  password          String    @db.VarChar(255)
  remember_token    String?   @db.VarChar(100)
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)

  @@index([workspace_id], map: "users_workspace_id_index")
}

model workspaces {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  owner_id   BigInt?   @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  rev        BigInt    @default(0) @db.UnsignedBigInt
}

model uploads {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id  BigInt    @db.UnsignedBigInt
  original_name String    @db.VarChar(255)
  stored_name   String    @db.VarChar(255)
  mime_type     String    @db.VarChar(100)
  size          BigInt    @db.UnsignedBigInt
  uploaded_by   BigInt    @db.UnsignedBigInt
  created_at    DateTime? @default(now()) @db.Timestamp(0)

  @@index([workspace_id], map: "uploads_workspace_id_index")
}
